<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Accepted_Offer_Is_Locked</fullName>
    <active>true</active>
    <description>Once an offer is accepted, the status cannot be changed.</description>
    <errorConditionFormula>AND(ISCHANGED(Status__c), ISPICKVAL(PRIORVALUE(Status__c), &quot;Offer Accepted&quot;))</errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>An accepted offer cannot be changed.</errorMessage>
</ValidationRule>
